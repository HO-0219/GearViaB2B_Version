[Unit]
Description=Apply a GearVia domain/TLS change request
After=b2bgearvia.service
Requires=b2bgearvia.service

[Service]
Type=oneshot
User=root
# Process every pending request through the fixed-path applier, then move the
# consumed request aside so the .path unit does not re-trigger on it.
ExecStart=/bin/bash -c 'set -eu; d=/var/lib/gearvia/control/requests; mkdir -p "$d/.consumed"; for f in "$d"/*.env; do [ -e "$f" ] || continue; /opt/b2bgearvia/host-apply/gearvia-host-apply.sh "$f" || true; mv -f "$f" "$d/.consumed/"; done'
Nice=10
ProtectHome=true
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
