APP_ENVIRONMENT=b2b-production
DOMAIN_NAME=192.168.56.101
JWT_SECRET=replace-with-openssl-rand-base64-48
AUTH_SECURE_COOKIE=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
DEMO_ENABLED=false
ADMIN_ENABLED=true
ADMIN_MFA_ENCRYPTION_KEY_BASE64=replace-with-openssl-rand-base64-32
ADMIN_ALLOWED_IPS=192.168.56.0/24
ADMIN_TRUSTED_PROXIES=172.16.0.0/12
FRONTEND_URL=https://192.168.56.101
ADMIN_FRONTEND_URL=https://192.168.56.101

# File storage: local (default) or nas_mount. STORAGE_NAS_ROOT is required and
# must already be mounted on the host when using nas_mount.
STORAGE_PROVIDER=local
STORAGE_NAS_ROOT=

# AI model allow-list shown to admins. Only used if the AI key is configured
# via installer/commands/configure-ai.sh; both have working defaults.
AI_SUPPORTED_MODELS=gpt-5.6-sol,gpt-5.6-luna
AI_ASSISTANT_EMBEDDING_MODEL=text-embedding-3-small
MYSQL_APP_PASSWORD=replace-with-openssl-rand-hex-24
MYSQL_ROOT_PASSWORD=gearvia
MYSQL_IMAGE=mysql:8.4
INIT_DATA_IMAGE=busybox:1.37
BACKEND_IMAGE=b2bgearvia-backend:virtualbox
WEB_IMAGE=b2bgearvia-web:virtualbox
TLS_CERT_FILE=./tls/fullchain.pem
TLS_KEY_FILE=./tls/privkey.pem
