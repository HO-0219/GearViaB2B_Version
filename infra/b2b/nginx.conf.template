server {
  listen 443 ssl;
  server_name ${DOMAIN_NAME};
  ssl_certificate /etc/nginx/tls/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  location = /healthz { return 200 "ok\n"; }
  location /api/ { proxy_pass http://backend:8081; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto https; }
  location = /mcp { proxy_pass http://backend:8081; proxy_http_version 1.1; proxy_buffering off; proxy_read_timeout 300s; proxy_set_header Connection ""; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto https; }
  location = /ws/chat { proxy_pass http://backend:8081; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; }
  location / { root /usr/share/nginx/html; try_files $uri $uri/ /index.html; }
}
