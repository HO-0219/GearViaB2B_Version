# Use a dedicated, short-lived read-only token. Never commit a real token.
BASE_URL=https://gearvia.internal
ACCESS_TOKEN=replace-with-short-lived-test-token
ENDPOINT=/api/v1/auth/me
CONCURRENCY=10
REQUESTS=200
P95_LIMIT_MS=1000
MAX_ERROR_PERCENT=1
INTEGRITY_VERIFIED=false
RECOVERY_VERIFIED=false
# Required readable evidence files before either VERIFIED flag may be true.
INTEGRITY_EVIDENCE=
RECOVERY_EVIDENCE=
TOPOLOGY=single-node
