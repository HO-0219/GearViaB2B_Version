# B2BGearVia on-premise production template.
# Copy to .env on the server and replace every replace-with-* placeholder with
# installer-generated values. Never commit a real .env file.

APP_ENVIRONMENT=b2b-production
SERVER_PORT=8081
FRONTEND_URL=https://b2bgearvia.internal
VITE_API_BASE_URL=/api/v1
VITE_PUBLIC_SITE_URL=https://b2bgearvia.internal
VITE_ALLOW_INDEXING=false
VITE_ADMIN_PORT=19091

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/b2bgearvia?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
SPRING_DATASOURCE_USERNAME=b2bgearvia
SPRING_DATASOURCE_PASSWORD=replace-with-generated-db-password-at-least-16-characters
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

MYSQL_DATABASE=b2bgearvia
MYSQL_USER=b2bgearvia
MYSQL_PASSWORD=replace-with-generated-db-password-at-least-16-characters
MYSQL_ROOT_PASSWORD=replace-with-generated-root-password-at-least-16-characters

# Leave blank to log only to stdout, which is recommended in containers.
LOG_FILE=
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_LEVEL_ORG_HIBERNATE_SQL=INFO
LOGGING_LEVEL_COM_TEAMPROJECT_NOTIFICATION=INFO
LOG_MAX_FILE_SIZE=20MB
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=1GB

JWT_SECRET=replace-with-generated-jwt-secret-at-least-32-characters
JWT_ACCESS_SECONDS=3600
JWT_REFRESH_SECONDS=1209600
JWT_PWA_REFRESH_IDLE_SECONDS=2592000
JWT_PWA_REFRESH_ABSOLUTE_SECONDS=7776000
JWT_REFRESH_CLEANUP_MS=86400000
AUTH_SECURE_COOKIE=true
SERVER_FORWARD_HEADERS_STRATEGY=framework
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_ATTEMPTS=10
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60

# Public signup and recovery mail are not required in the B2B product.
# Enable only when a customer SMTP server is available for notifications.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@b2bgearvia.local
MAIL_VERIFICATION_MINUTES=10
PASSWORD_RESET_MINUTES=30

# Web Push is optional and depends on browser push provider access.
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@b2bgearvia.local

# Uploads must use the local persistent path mounted by the production stack.
STORAGE_PROVIDER=local
UPLOAD_LOCAL_ROOT=/opt/b2bgearvia/data/uploads
UPLOAD_MAX_FILE_SIZE=100MB
UPLOAD_MAX_REQUEST_SIZE=101MB

ADMIN_ENABLED=true
ADMIN_PORT=19092
ADMIN_ALLOWED_IPS=127.0.0.1,::1
ADMIN_TRUSTED_PROXIES=127.0.0.1,::1
ADMIN_FRONTEND_URL=https://b2bgearvia.internal:19091
ADMIN_MFA_ENCRYPTION_KEY_BASE64=replace-with-base64-key-decoding-to-exactly-32-random-bytes

REPORT_MAIL_CRON=0 0 8 * * *
REPORT_RETRY_CRON=0 20 * * * *
CALENDAR_REJECTED_TASK_RETENTION_HOURS=24

DEMO_ENABLED=false
DEMO_USERNAME=

B2B_CHAT_MESSAGE_RETENTION_DAYS=365
B2B_CHAT_CHANNEL_LIMIT=50
B2B_GROUP_STORAGE_BYTES=5368709120
B2B_ATTACHMENT_LIMIT_BYTES=104857600

# AI is optional. Leave OPENAI_API_KEY blank to keep AI reports and assistant
# features disabled while the rest of the application runs normally.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REQUEST_TIMEOUT=45s
OPENAI_MAX_OUTPUT_TOKENS=3000
AI_REPORT_ENABLED=false
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_MODEL=gpt-5.6-sol
AI_ASSISTANT_REQUEST_TIMEOUT=30s
AI_ASSISTANT_MAX_OUTPUT_TOKENS=800
AI_ASSISTANT_MESSAGE_RETENTION_DAYS=90
# Optional installer-provided one-time admin bootstrap file (key=value: username, email, name, password).
BOOTSTRAP_ADMIN_SECRET_FILE=
