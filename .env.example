SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/b2bgearvia?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
SPRING_DATASOURCE_USERNAME=replace-with-local-db-username
SPRING_DATASOURCE_PASSWORD=replace-with-local-db-password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

MYSQL_DATABASE=b2bgearvia
MYSQL_ROOT_PASSWORD=replace-with-local-mysql-root-password

SERVER_PORT=8081
FRONTEND_URL=http://localhost:5174
VITE_API_BASE_URL=/api/v1
APP_ENVIRONMENT=local
# Leave blank to log only to stdout (recommended in containers).
LOG_FILE=

JWT_SECRET=replace-with-at-least-64-random-bytes
JWT_ACCESS_SECONDS=3600
JWT_REFRESH_SECONDS=1209600
JWT_PWA_REFRESH_IDLE_SECONDS=2592000
JWT_PWA_REFRESH_ABSOLUTE_SECONDS=7776000
JWT_REFRESH_CLEANUP_MS=86400000
AUTH_SECURE_COOKIE=false

MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@b2bgearvia.local
MAIL_VERIFICATION_MINUTES=10
PASSWORD_RESET_MINUTES=30

# Web Push VAPID keys (base64url). Generate once and keep the private key secret.
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-public-contact-email

# Placeholders only. Never commit real credentials.
OAUTH2_GOOGLE_CLIENT_ID=disabled
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH_SIGNUP_CLEANUP_MS=900000
OAUTH2_KAKAO_CLIENT_ID=disabled
OAUTH2_KAKAO_CLIENT_SECRET=

# The single-server deployment stores uploads in a Docker persistent volume mounted here.
UPLOAD_LOCAL_ROOT=/opt/b2bgearvia/data/uploads
UPLOAD_MAX_FILE_SIZE=100MB
UPLOAD_MAX_REQUEST_SIZE=101MB
STORAGE_PROVIDER=local

# Toss Payments: never commit real values. Client key is public; secret/encryption keys are server-only.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 32 random bytes, base64 encoded. Keep stable or stored billing keys cannot be decrypted.
PAYMENT_ENCRYPTION_KEY_BASE64=
TOSS_TEST_MODE=true
# PG 운영 심사 완료 후 live 키와 함께 true로 전환합니다.
SUBSCRIPTION_LIVE_BILLING_ENABLED=false
SUBSCRIPTION_TRIAL_DAYS=30
SUBSCRIPTION_TEAM_MONTHLY_PRICE=9900
SUBSCRIPTION_PAYMENT_GRACE_DAYS=7
# Group collaboration entitlements. Text messages are cleaned up by retention; attachments count toward storage.
CHAT_FREE_RETENTION_DAYS=10
CHAT_PAID_RETENTION_DAYS=365
CHAT_PAID_CHANNEL_LIMIT=50
GROUP_FREE_STORAGE_BYTES=104857600
GROUP_PAID_STORAGE_BYTES=5368709120

# Keep disabled until the admin listener is protected by a server firewall/VPN allow-list.
ADMIN_ENABLED=false
ADMIN_PORT=19092
ADMIN_ALLOWED_IPS=127.0.0.1,::1
# Only these direct proxy peers may supply X-Forwarded-For for admin IP checks.
ADMIN_TRUSTED_PROXIES=127.0.0.1,::1
# Generate independently: openssl rand -base64 32
ADMIN_MFA_ENCRYPTION_KEY_BASE64=
ADMIN_FRONTEND_URL=http://localhost:19091
VITE_ADMIN_PORT=19091

# Reports are sent at 08:00 Asia/Seoul. Override only with a six-field Spring cron.
REPORT_MAIL_CRON=0 0 8 * * *
REPORT_RETRY_CRON=0 20 * * * *

DEMO_ENABLED=true
DEMO_USERNAME=demo_leader
MEMBERSHIP_TEST_SWITCH_ENABLED=true
CALENDAR_REJECTED_TASK_RETENTION_HOURS=24

# AI reports. Keep disabled until a server-side OpenAI key is configured.
# Every generation is a billed provider call.
AI_REPORT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REQUEST_TIMEOUT=45s
OPENAI_MAX_OUTPUT_TOKENS=3000

# AI assistant. The assistant only proposes actions; authenticated users must
# explicitly confirm before the server executes them with their existing permissions.
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_MODEL=gpt-5.6-sol
AI_ASSISTANT_REQUEST_TIMEOUT=30s
AI_ASSISTANT_MAX_OUTPUT_TOKENS=800
AI_ASSISTANT_MESSAGE_RETENTION_DAYS=90

# Public canonical origin used for robots.txt, sitemap.xml, and canonical links.
VITE_PUBLIC_SITE_URL=http://localhost:5174
# Keep false for local, QA, and pre-production. Set true only for approved production launch.
VITE_ALLOW_INDEXING=false
# Paste the Search Console HTML-tag verification token here for production.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_PRIVACY_CONTACT=replace-with-public-privacy-contact
VITE_CONTACT_EMAIL=replace-with-public-contact-email
